generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Role assignment
  isChief       Boolean    @default(false)
  supervisorId  String?
  supervisor    User?      @relation("SupervisorRelation", fields: [supervisorId], references: [id])
  directs       User[]     @relation("SupervisorRelation")

  // OKRAs they own
  objectives    Objective[]
  keyResults    KeyResult[]
  actions       Action[]

  // Notes/Comments
  notes         Note[]

  // Cross-team access
  canAccess     CrossTeamAccess[] @relation("AccessGrantedBy")
  accessFrom    CrossTeamAccess[] @relation("AccessGrantedTo")

  // Team color
  teamColor     String?

  // NextAuth sessions
  accounts      Account[]
  sessions      Session[]

  @@index([supervisorId])
  @@index([email])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CrossTeamAccess {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation("AccessGrantedBy", fields: [userId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User   @relation("AccessGrantedTo", fields: [targetUserId], references: [id], onDelete: Cascade)
  accessType   String // "view" or "edit"
  createdAt    DateTime @default(now())

  @@unique([userId, targetUserId, accessType])
  @@index([userId])
  @@index([targetUserId])
}

model Objective {
  id          String     @id @default(cuid())
  title       String
  description String?
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fiscalYear  String     // "FY27", etc
  quarter     String?    // "Q1", "Q2", etc
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  keyResults  KeyResult[]
  notes       Note[]

  @@index([ownerId])
  @@index([fiscalYear])
}

model KeyResult {
  id           String     @id @default(cuid())
  title        String
  description  String?
  objectiveId  String
  objective    Objective  @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  ownerId      String
  owner        User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status       String     @default("on_track") // "on_track", "at_risk", "off_track"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  actions      Action[]
  notes        Note[]

  @@index([objectiveId])
  @@index([ownerId])
}

model Action {
  id          String     @id @default(cuid())
  title       String
  description String?
  keyResultId String
  keyResult   KeyResult  @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status      String     @default("pending") // "pending", "in_progress", "completed"
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  notes       Note[]

  @@index([keyResultId])
  @@index([ownerId])
  @@index([status])
}

model Note {
  id          String     @id @default(cuid())
  content     String
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Can be attached to various items
  objectiveId String?
  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResultId String?
  keyResult   KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  actionId    String?
  action      Action?    @relation(fields: [actionId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([authorId])
  @@index([objectiveId])
  @@index([keyResultId])
  @@index([actionId])
}
